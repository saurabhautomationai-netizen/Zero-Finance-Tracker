    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'From: ' + ($json.from?.value?.[0]?.address || $json.from?.text || '') + '\\nSubject: ' + ($json.subject || '') + '\\nSnippet: ' + ($json.snippet || '') + '\\nBody: ' + ($json.text || $json.snippet || '') }}",
        "options": {
          "systemMessage": "=You are a precision financial transaction extractor for an automated accounting agent.\n\nAnalyze the email subject, sender, and text body.\nExtract transaction details.\n\nReturn ONLY a JSON object (no markdown, no backticks, no code block) with these exact keys:\n{\n  \"Date\": \"YYYY-MM-DD\" (transaction date, fallback to current date if missing),\n  \"Type\": \"expense\" or \"income\",\n  \"Category\": \"Food\" | \"Groceries\" | \"Transport\" | \"Shopping\" | \"Bills\" | \"Subscription\" | \"Investment\" | \"Salary\" | \"Bank Charges\" | \"Other\",\n  \"Vendor\": \"Merchant/Bank name (e.g. Swiggy, Zomato, Amazon, Uber, HDFC Bank, SBI, OpenAI, Claude, n8n)\",\n  \"Product\": \"Short product/item name (e.g. Food Delivery, Cab ride, Monthly Subscription, Payment)\",\n  \"Amount\": 123.45 (numeric amount without symbols),\n  \"Currency\": \"INR\" (or USD/EUR),\n  \"currency_symbol\": \"\u20b9\",\n  \"is_financial\": true (false if promotional marketing or newsletter without specific money transaction)\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        380,
        100
      ],
      "id": "4a9cd68d-ae9b-49e5-9e75-448dd45281d8",
      "name": "AI Email Parser"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        380,
        300
      ],
      "id": "53fb71ae-330b-4e3c-9102-696ca178b800",
      "name": "OpenAI Model",
      "credentials": {
        "openAiApi": {
          "id": "EcmVOJevkH9JnGeq",
          "name": "OpenAi Feedback"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet raw = input.output || input.text || input.content || '';\n\nraw = String(raw)\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nconst jsonString = match ? match[0] : raw;\n\nlet tx = {};\ntry {\n  tx = JSON.parse(jsonString);\n} catch (e) {\n  tx = { is_financial: false };\n}\n\nconst emailData = $('Get Email Details').first().json || {};\nconst date = String(tx.Date || new Date().toISOString().slice(0, 10)).trim();\nconst month = date.slice(0, 7);\n\nlet type = 'expense';\nconst rawType = String(tx.Type || 'expense').toLowerCase().trim();\nif (['income', 'credit', 'salary', 'deposit'].some(k => rawType.includes(k))) {\n  type = 'income';\n} else if (rawType.includes('transfer')) {\n  type = 'transfer';\n} else if (['investment', 'invest', 'gold', 'stocks', 'mutual'].some(k => rawType.includes(k))) {\n  type = 'investment';\n} else {\n  type = 'expense';\n}\n\nconst category = tx.Category || 'Other';\nconst vendor = tx.Vendor || 'N/A';\nconst product = tx.Product || vendor;\nconst amount = Number(tx.Amount ?? 0);\nconst currency = tx.Currency || 'INR';\nconst currencySymbol = tx.currency_symbol || '\u20b9';\nconst whatsappNumber = '1104381256';\n\nconst duplicateKey = `${whatsappNumber}|${date}|${type}|${category.toLowerCase()}|${vendor.toLowerCase()}|${amount}`;\n\nreturn [{\n  json: {\n    is_financial: Boolean(tx.is_financial && amount > 0),\n    whatsapp_number: whatsappNumber,\n    Month: month,\n    Date: date,\n    Type: type,\n    Category: category,\n    Vendor: vendor,\n    Product: product,\n    Amount: amount,\n    Currency: currency,\n    currency_symbol: currencySymbol,\n    duplicate_key: duplicateKey,\n    source: 'email',\n    from_email: emailData.from?.value?.[0]?.address || emailData.from?.text || 'saurabh7596@gmail.com',\n    email_subject: emailData.subject || '',\n    thread_id: emailData.id || emailData.threadId || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        100
      ],
      "id": "e4a8b792-7471-460d-8526-11b333918a22",
      "name": "Format Email Transaction"
